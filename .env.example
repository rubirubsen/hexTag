# Port nach aussen
HEXTAG_PORT=8480
APP_URL=http://localhost:8480
JWT_SECRET=super_sicheres_jwt_geheimnis_12345

# --- MICROSOFT SQL SERVER (MSSQL) ---
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_DATABASE=hexTagDB
DB_USER=sa
DB_PASSWORD=DeinMssqlPasswort123!
DB_ENCRYPT=false
DB_TRUST_CERT=true

# --- SSO: GOOGLE ---
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=deine-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dein-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8480/api/auth/google/callback

# --- SSO: TWITCH ---
# https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=deine-twitch-client-id
TWITCH_CLIENT_SECRET=dein-twitch-client-secret
TWITCH_CALLBACK_URL=http://localhost:8480/api/auth/twitch/callback

# --- SSO: DISCORD ---
# https://discord.com/developers/applications
DISCORD_CLIENT_ID=deine-discord-client-id
